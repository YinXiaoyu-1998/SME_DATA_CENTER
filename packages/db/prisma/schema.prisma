generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

enum EmployeeRole {
  admin
  employee
}

enum DocumentStatus {
  uploading
  pending_processing
  processing
  active
  processing_failed
  archived
}

enum DocumentType {
  raw_material
  structured_dataset
  analysis_artifact
  business_event
  management_knowledge
}

enum DocumentKind {
  evidence
  structured
  quarantine_certificate
}

enum FileType {
  md
  txt
  docx
  xlsx
  csv
  jpg
  jpeg
  png
  pdf
}

enum ProcessingRunStatus {
  queued
  running
  succeeded
  failed
  retry_scheduled
}

enum ProcessingJobType {
  evidence_document_index
  structured_import
  structured_partition_import
}

enum RetrievalConfigStatus {
  active
  candidate
  deprecated
}

enum DocumentIndexStatus {
  pending
  indexing
  ready
  failed
  superseded
}

enum ImportDataset {
  dishes
  business
  vip
  dish_catalog
  delivery_ledger
  supplier_catalog
}

enum ImportBatchStatus {
  pending
  validating
  applying
  applied
  failed
  rejected
  archived
}

enum PartitionDataset {
  dishes
  business
}

enum PartitionImportJobStatus {
  uploading
  queued
  processing
  published
  rejected
  failed
  cancelled
  expired
}

enum SkillEntryStatus {
  approved
  disabled
}

enum LoginIdentityProvider {
  local_password
}

enum PasswordSetupPurpose {
  initial_setup
  password_reset
}

enum DeviceAuthorizationStatus {
  pending
  completed
  expired
  revoked
}

enum AuthSessionStatus {
  active
  revoked
  expired
}

enum DurableCredentialStatus {
  active
  consumed
  revoked
}

enum AuthSecurityOutcome {
  succeeded
  failed
  denied
}

model Organization {
  id                     String                  @id @db.VarChar(64)
  name                   String                  @db.VarChar(255)
  createdAt              DateTime                @default(now()) @map("created_at")
  updatedAt              DateTime                @updatedAt @map("updated_at")
  employees              Employee[]
  documents              Document[]
  processingRuns         ProcessingRun[]
  documentIndexes        DocumentIndex[]
  importBatches          ImportBatch[]
  importClaims           ImportWindowClaim[]
  partitionImportJobs    PartitionImportJob[]
  structuredPartitions   StructuredPartition[]
  vipRows                VipRow[]
  dishCatalogRows        DishCatalogRow[]
  deliveryLedgerRows     DeliveryLedgerRow[]
  supplierCatalogRows    SupplierCatalogRow[]
  quarantineCertificates QuarantineCertificate[]
  auditLogs              AuditLog[]
  skillEntries           SkillEntry[]
  loginIdentities        LoginIdentity[]
  authSessions           AuthSession[]
  deviceAuthorizations   DeviceAuthorization[]
  oauthTokens            OAuthAccessToken[]
  authEvents             AuthSecurityEvent[]

  @@map("organizations")
}

model Employee {
  id                   String                @id @default(cuid()) @db.VarChar(32)
  orgId                String                @map("org_id") @db.VarChar(64)
  email                String                @unique @db.VarChar(320)
  displayName          String                @map("display_name") @db.VarChar(255)
  role                 EmployeeRole
  clearance            Int                   @db.UnsignedTinyInt
  disabled             Boolean               @default(false)
  createdAt            DateTime              @default(now()) @map("created_at")
  updatedAt            DateTime              @updatedAt @map("updated_at")
  organization         Organization          @relation(fields: [orgId], references: [id], onDelete: Restrict)
  uploadedDocs         Document[]            @relation("DocumentUploader")
  auditLogs            AuditLog[]            @relation("AuditActor")
  loginIdentities      LoginIdentity[]
  authSessions         AuthSession[]
  deviceAuthorizations DeviceAuthorization[]
  oauthTokens          OAuthAccessToken[]
  authEvents           AuthSecurityEvent[]
  partitionImports     PartitionImportJob[]

  @@index([orgId])
  @@map("employees")
}

model Document {
  id                    String                 @id @default(cuid()) @db.VarChar(32)
  orgId                 String                 @map("org_id") @db.VarChar(64)
  title                 String                 @db.VarChar(512)
  documentType          DocumentType           @map("document_type")
  documentKind          DocumentKind?          @map("document_kind")
  fileType              FileType?              @map("file_type")
  status                DocumentStatus         @default(uploading)
  confidentialityLevel  Int                    @default(0) @map("confidentiality_level") @db.UnsignedTinyInt
  contentVersion        Int                    @default(1) @map("content_version")
  storageObjectKey      String                 @map("storage_object_key") @db.VarChar(1024)
  originalFileName      String?                @map("original_file_name") @db.VarChar(512)
  contentType           String?                @map("content_type") @db.VarChar(255)
  byteSize              BigInt?                @map("byte_size")
  checksumSha256        String?                @map("checksum_sha256") @db.VarChar(64)
  uploaderId            String                 @map("uploader_employee_id") @db.VarChar(32)
  sourceSystem          String?                @map("source_system") @db.VarChar(255)
  sourceTime            DateTime?              @map("source_time")
  sourceMetadata        Json?                  @map("source_metadata")
  createdAt             DateTime               @default(now()) @map("created_at")
  updatedAt             DateTime               @updatedAt @map("updated_at")
  archivedAt            DateTime?              @map("archived_at")
  organization          Organization           @relation(fields: [orgId], references: [id], onDelete: Restrict)
  uploader              Employee               @relation("DocumentUploader", fields: [uploaderId], references: [id], onDelete: Restrict)
  processingRuns        ProcessingRun[]
  chunks                DocumentChunk[]
  indexes               DocumentIndex[]
  importBatch           ImportBatch?
  vipRows               VipRow[]
  dishCatalogRows       DishCatalogRow[]
  deliveryLedgerRows    DeliveryLedgerRow[]
  supplierCatalogRows   SupplierCatalogRow[]
  quarantineCertificate QuarantineCertificate?

  @@index([orgId, status])
  @@index([orgId, status, confidentialityLevel])
  @@index([orgId, documentType])
  @@index([orgId, documentKind, status])
  @@index([uploaderId])
  @@index([sourceTime])
  @@map("documents")
}

model ProcessingRun {
  id                   String              @id @default(cuid()) @db.VarChar(32)
  orgId                String              @map("org_id") @db.VarChar(64)
  documentId           String?             @map("document_id") @db.VarChar(32)
  partitionImportJobId String?             @unique @map("partition_import_job_id") @db.VarChar(32)
  jobKey               String              @unique @map("job_key") @db.VarChar(255)
  status               ProcessingRunStatus @default(queued)
  jobType              ProcessingJobType   @map("job_type")
  attemptNumber        Int                 @default(0) @map("attempt_number")
  retryCount           Int                 @default(0) @map("retry_count")
  availableAt          DateTime            @default(now()) @map("available_at")
  lockedBy             String?             @map("locked_by") @db.VarChar(128)
  lockedUntil          DateTime?           @map("locked_until")
  lastHeartbeatAt      DateTime?           @map("last_heartbeat_at")
  errorCode            String?             @map("error_code") @db.VarChar(128)
  errorSummary         String?             @map("error_summary") @db.Text
  startedAt            DateTime?           @map("started_at")
  finishedAt           DateTime?           @map("finished_at")
  createdAt            DateTime            @default(now()) @map("created_at")
  updatedAt            DateTime            @updatedAt @map("updated_at")
  organization         Organization        @relation(fields: [orgId], references: [id], onDelete: Restrict)
  document             Document?           @relation(fields: [documentId], references: [id], onDelete: Cascade)
  partitionImportJob   PartitionImportJob? @relation(fields: [partitionImportJobId], references: [id], onDelete: Cascade)

  @@index([orgId, status])
  @@index([status, availableAt, lockedUntil])
  @@index([documentId])
  @@map("processing_runs")
}

model DocumentChunk {
  id                     String         @id @default(cuid()) @db.VarChar(32)
  documentId             String         @map("document_id") @db.VarChar(32)
  documentIndexId        String?        @map("document_index_id") @db.VarChar(32)
  chunkId                String?        @map("chunk_id") @db.VarChar(128)
  chunkIndex             Int            @map("chunk_index")
  chunkText              String         @map("chunk_text") @db.Text
  chunkHash              String         @map("chunk_hash") @db.VarChar(64)
  indexType              String         @default("text") @map("index_type") @db.VarChar(64)
  modelName              String?        @map("model_name") @db.VarChar(128)
  modelVersion           String?        @map("model_version") @db.VarChar(128)
  contentVersion         Int            @default(1) @map("content_version")
  retrievalConfigVersion String?        @map("retrieval_config_version") @db.VarChar(128)
  qdrantPointId          String?        @map("qdrant_point_id") @db.VarChar(128)
  sourceLocation         Json?          @map("source_location")
  createdAt              DateTime       @default(now()) @map("created_at")
  document               Document       @relation(fields: [documentId], references: [id], onDelete: Cascade)
  documentIndex          DocumentIndex? @relation(fields: [documentIndexId], references: [id], onDelete: SetNull)

  @@unique([documentIndexId, chunkId])
  @@index([documentId, chunkHash, indexType])
  @@index([documentId, chunkIndex])
  @@index([qdrantPointId])
  @@map("document_chunks")
}

model RetrievalConfig {
  id                     String                @id @default(cuid()) @db.VarChar(32)
  version                String                @unique @db.VarChar(128)
  status                 RetrievalConfigStatus @default(candidate)
  chunkerName            String                @map("chunker_name") @db.VarChar(128)
  denseEmbeddingProvider String                @map("dense_embedding_provider") @db.VarChar(128)
  denseEmbeddingModel    String                @map("dense_embedding_model") @db.VarChar(255)
  denseVectorDimension   Int                   @map("dense_vector_dimension")
  sparseModel            String?               @map("sparse_model") @db.VarChar(255)
  rerankProvider         String?               @map("rerank_provider") @db.VarChar(128)
  rerankModel            String?               @map("rerank_model") @db.VarChar(255)
  qdrantCollection       String                @map("qdrant_collection") @db.VarChar(255)
  configJson             Json                  @map("config_json")
  createdAt              DateTime              @default(now()) @map("created_at")
  updatedAt              DateTime              @updatedAt @map("updated_at")
  documentIndexes        DocumentIndex[]

  @@index([status, version])
  @@map("retrieval_configs")
}

model DocumentIndex {
  id                String              @id @default(cuid()) @db.VarChar(32)
  orgId             String              @map("org_id") @db.VarChar(64)
  documentId        String              @map("document_id") @db.VarChar(32)
  retrievalConfigId String              @map("retrieval_config_id") @db.VarChar(32)
  contentVersion    Int                 @map("content_version")
  status            DocumentIndexStatus @default(pending)
  qdrantCollection  String              @map("qdrant_collection") @db.VarChar(255)
  indexedChunkCount Int                 @default(0) @map("indexed_chunk_count")
  errorCode         String?             @map("error_code") @db.VarChar(128)
  errorSummary      String?             @map("error_summary") @db.Text
  parserFingerprint String?             @map("parser_fingerprint") @db.VarChar(256)
  parsedObjectKey   String?             @map("parsed_object_key") @db.VarChar(1024)
  parseSummary      Json?               @map("parse_summary")
  startedAt         DateTime?           @map("started_at")
  readyAt           DateTime?           @map("ready_at")
  createdAt         DateTime            @default(now()) @map("created_at")
  updatedAt         DateTime            @updatedAt @map("updated_at")
  organization      Organization        @relation(fields: [orgId], references: [id], onDelete: Restrict)
  document          Document            @relation(fields: [documentId], references: [id], onDelete: Cascade)
  retrievalConfig   RetrievalConfig     @relation(fields: [retrievalConfigId], references: [id], onDelete: Restrict)
  chunks            DocumentChunk[]

  @@unique([documentId, retrievalConfigId, contentVersion])
  @@index([orgId, status])
  @@index([documentId, status])
  @@map("document_indexes")
}

model ImportBatch {
  id                   String               @id @default(cuid()) @db.VarChar(32)
  orgId                String               @map("org_id") @db.VarChar(64)
  sourceDocumentId     String               @unique @map("source_document_id") @db.VarChar(32)
  dataset              ImportDataset
  startDate            DateTime?            @map("start_date") @db.Date
  endDate              DateTime?            @map("end_date") @db.Date
  idempotencyKey       String               @map("idempotency_key") @db.VarChar(255)
  requestFingerprint   String               @map("request_fingerprint") @db.VarChar(64)
  naturalKey           String?              @map("natural_key") @db.VarChar(255)
  appliedAt            DateTime?            @map("applied_at")
  status               ImportBatchStatus    @default(pending)
  sourceSheetSummary   Json?                @map("source_sheet_summary")
  validationErrors     Json?                @map("validation_errors")
  validationErrorCount Int                  @default(0) @map("validation_error_count")
  totalRowCount        Int                  @default(0) @map("total_row_count")
  appliedRowCount      Int                  @default(0) @map("applied_row_count")
  errorCode            String?              @map("error_code") @db.VarChar(128)
  errorSummary         String?              @map("error_summary") @db.Text
  createdAt            DateTime             @default(now()) @map("created_at")
  updatedAt            DateTime             @updatedAt @map("updated_at")
  archivedAt           DateTime?            @map("archived_at")
  organization         Organization         @relation(fields: [orgId], references: [id], onDelete: Restrict)
  sourceDocument       Document             @relation(fields: [sourceDocumentId], references: [id], onDelete: Restrict)
  windowClaim          ImportWindowClaim?
  vipRows              VipRow[]
  dishCatalogRows      DishCatalogRow[]
  deliveryLedgerRows   DeliveryLedgerRow[]
  supplierCatalogRows  SupplierCatalogRow[]

  @@unique([orgId, idempotencyKey])
  @@unique([orgId, dataset, naturalKey], map: "import_batches_org_dataset_natural_key_uq")
  @@index([orgId, dataset, status])
  @@index([orgId, dataset, startDate, endDate])
  @@map("import_batches")
}

model ImportWindowClaim {
  id            String        @id @default(cuid()) @db.VarChar(32)
  orgId         String        @map("org_id") @db.VarChar(64)
  dataset       ImportDataset
  startDate     DateTime      @map("start_date") @db.Date
  endDate       DateTime      @map("end_date") @db.Date
  importBatchId String        @unique @map("import_batch_id") @db.VarChar(32)
  createdAt     DateTime      @default(now()) @map("created_at")
  organization  Organization  @relation(fields: [orgId], references: [id], onDelete: Restrict)
  importBatch   ImportBatch   @relation(fields: [importBatchId], references: [id], onDelete: Cascade)

  @@unique([orgId, dataset, startDate, endDate])
  @@map("import_window_claims")
}

model QuarantineCertificate {
  id                 String       @id @default(cuid()) @db.VarChar(32)
  orgId              String       @map("org_id") @db.VarChar(64)
  sourceDocumentId   String       @unique @map("source_document_id") @db.VarChar(32)
  receiptId          String       @map("receipt_id") @db.VarChar(255)
  idempotencyKey     String       @map("idempotency_key") @db.VarChar(255)
  requestFingerprint String       @map("request_fingerprint") @db.VarChar(64)
  createdAt          DateTime     @default(now()) @map("created_at")
  organization       Organization @relation(fields: [orgId], references: [id], onDelete: Restrict)
  sourceDocument     Document     @relation(fields: [sourceDocumentId], references: [id], onDelete: Restrict)

  @@unique([orgId, idempotencyKey])
  @@index([orgId, receiptId])
  @@map("quarantine_certificates")
}

model PartitionImportJob {
  id                   String                   @id @db.VarChar(32)
  orgId                String                   @map("org_id") @db.VarChar(64)
  uploaderId           String                   @map("uploader_employee_id") @db.VarChar(32)
  dataset              PartitionDataset
  enterpriseKey        String                   @map("enterprise_key") @db.VarChar(191)
  enterpriseName       String                   @map("enterprise_name") @db.VarChar(255)
  confidentialityLevel Int                      @map("confidentiality_level") @db.UnsignedTinyInt
  idempotencyKey       String                   @map("idempotency_key") @db.VarChar(255)
  requestFingerprint   String                   @map("request_fingerprint") @db.VarChar(64)
  originalFileName     String                   @map("original_file_name") @db.VarChar(512)
  mediaType            String                   @map("media_type") @db.VarChar(255)
  sourceByteSize       BigInt                   @map("source_byte_size")
  sourceChecksumSha256 String                   @map("source_checksum_sha256") @db.VarChar(64)
  sourceStartDate      DateTime                 @map("source_start_date") @db.Date
  sourceEndDate        DateTime                 @map("source_end_date") @db.Date
  temporaryObjectKey   String?                  @map("temporary_object_key") @db.VarChar(512)
  multipartUploadId    String?                  @map("multipart_upload_id") @db.VarChar(512)
  status               PartitionImportJobStatus @default(uploading)
  totalRowCount        BigInt                   @default(0) @map("total_row_count")
  partitionCount       Int                      @default(0) @map("partition_count")
  errorCode            String?                  @map("error_code") @db.VarChar(128)
  errorSummary         String?                  @map("error_summary") @db.Text
  validationErrors     Json?                    @map("validation_errors")
  expiresAt            DateTime                 @map("expires_at")
  publishedAt          DateTime?                @map("published_at")
  finishedAt           DateTime?                @map("finished_at")
  createdAt            DateTime                 @default(now()) @map("created_at")
  updatedAt            DateTime                 @updatedAt @map("updated_at")
  organization         Organization             @relation(fields: [orgId], references: [id], onDelete: Restrict)
  uploader             Employee                 @relation(fields: [uploaderId], references: [id], onDelete: Restrict)
  processingRun        ProcessingRun?

  @@unique([orgId, idempotencyKey])
  @@index([status, expiresAt])
  @@index([orgId, uploaderId, createdAt])
  @@map("partition_import_jobs")
}

model StructuredPartition {
  id                   String           @id @db.VarChar(32)
  orgId                String           @map("org_id") @db.VarChar(64)
  enterpriseKey        String           @map("enterprise_key") @db.VarChar(191)
  enterpriseName       String           @map("enterprise_name") @db.VarChar(255)
  dataset              PartitionDataset
  storeKey             String           @map("store_key") @db.VarChar(255)
  merchantId           String?          @map("merchant_id") @db.VarChar(255)
  storeName            String           @map("store_name") @db.VarChar(255)
  businessDate         DateTime         @map("business_date") @db.Date
  objectKey            String           @unique @map("object_key") @db.VarChar(512)
  rowCount             BigInt           @map("row_count")
  byteSize             BigInt           @map("byte_size")
  checksumSha256       String           @map("checksum_sha256") @db.VarChar(64)
  confidentialityLevel Int              @map("confidentiality_level") @db.UnsignedTinyInt
  publishedByJobId     String           @map("published_by_job_id") @db.VarChar(32)
  createdAt            DateTime         @default(now()) @map("created_at")
  updatedAt            DateTime         @updatedAt @map("updated_at")
  organization         Organization     @relation(fields: [orgId], references: [id], onDelete: Restrict)

  @@unique([orgId, enterpriseKey, dataset, storeKey, businessDate], map: "structured_partitions_identity_uq")
  @@index([orgId, dataset, enterpriseKey, businessDate], map: "structured_partitions_manifest_idx")
  @@index([orgId, confidentialityLevel, dataset, businessDate], map: "structured_partitions_auth_idx")
  @@map("structured_partitions")
}

model StorageGarbage {
  id            String   @id @db.VarChar(32)
  objectKey     String   @unique @map("object_key") @db.VarChar(512)
  reason        String   @db.VarChar(64)
  attemptCount  Int      @default(0) @map("attempt_count")
  availableAt   DateTime @default(now()) @map("available_at")
  lastErrorCode String?  @map("last_error_code") @db.VarChar(128)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@index([availableAt])
  @@map("storage_garbage")
}

model VipRow {
  id               String       @id @default(cuid()) @db.VarChar(32)
  orgId            String       @map("org_id") @db.VarChar(64)
  sourceDocumentId String       @map("source_document_id") @db.VarChar(32)
  importBatchId    String       @map("import_batch_id") @db.VarChar(32)
  sourceSheetIndex Int          @default(0) @map("source_sheet_index")
  sourceSheetName  String       @default("Sheet1") @map("source_sheet_name") @db.VarChar(255)
  sourceRowNumber  Int          @map("source_row_number")
  payload          Json
  createdAt        DateTime     @default(now()) @map("created_at")
  organization     Organization @relation(fields: [orgId], references: [id], onDelete: Restrict)
  sourceDocument   Document     @relation(fields: [sourceDocumentId], references: [id], onDelete: Restrict)
  importBatch      ImportBatch  @relation(fields: [importBatchId], references: [id], onDelete: Cascade)

  @@unique([importBatchId, sourceSheetIndex, sourceRowNumber], map: "vip_rows_batch_sheet_row_uq")
  @@index([orgId, importBatchId])
  @@map("vip_rows")
}

model DishCatalogRow {
  id               String       @id @default(cuid()) @db.VarChar(32)
  orgId            String       @map("org_id") @db.VarChar(64)
  sourceDocumentId String       @map("source_document_id") @db.VarChar(32)
  importBatchId    String       @map("import_batch_id") @db.VarChar(32)
  sourceSheetIndex Int          @default(0) @map("source_sheet_index")
  sourceSheetName  String       @default("Sheet1") @map("source_sheet_name") @db.VarChar(255)
  sourceRowNumber  Int          @map("source_row_number")
  payload          Json
  createdAt        DateTime     @default(now()) @map("created_at")
  organization     Organization @relation(fields: [orgId], references: [id], onDelete: Restrict)
  sourceDocument   Document     @relation(fields: [sourceDocumentId], references: [id], onDelete: Restrict)
  importBatch      ImportBatch  @relation(fields: [importBatchId], references: [id], onDelete: Cascade)

  @@unique([importBatchId, sourceSheetIndex, sourceRowNumber], map: "dish_catalog_rows_batch_sheet_row_uq")
  @@index([orgId, importBatchId])
  @@map("dish_catalog_rows")
}

model DeliveryLedgerRow {
  id               String       @id @default(cuid()) @db.VarChar(32)
  orgId            String       @map("org_id") @db.VarChar(64)
  sourceDocumentId String       @map("source_document_id") @db.VarChar(32)
  importBatchId    String       @map("import_batch_id") @db.VarChar(32)
  sourceSheetIndex Int          @default(0) @map("source_sheet_index")
  sourceSheetName  String       @default("Sheet1") @map("source_sheet_name") @db.VarChar(255)
  sourceRowNumber  Int          @map("source_row_number")
  payload          Json
  createdAt        DateTime     @default(now()) @map("created_at")
  organization     Organization @relation(fields: [orgId], references: [id], onDelete: Restrict)
  sourceDocument   Document     @relation(fields: [sourceDocumentId], references: [id], onDelete: Restrict)
  importBatch      ImportBatch  @relation(fields: [importBatchId], references: [id], onDelete: Cascade)

  @@unique([importBatchId, sourceSheetIndex, sourceRowNumber], map: "delivery_ledger_rows_batch_sheet_row_uq")
  @@index([orgId, importBatchId])
  @@map("delivery_ledger_rows")
}

model SupplierCatalogRow {
  id               String       @id @default(cuid()) @db.VarChar(32)
  orgId            String       @map("org_id") @db.VarChar(64)
  sourceDocumentId String       @map("source_document_id") @db.VarChar(32)
  importBatchId    String       @map("import_batch_id") @db.VarChar(32)
  sourceSheetIndex Int          @default(0) @map("source_sheet_index")
  sourceSheetName  String       @default("Sheet1") @map("source_sheet_name") @db.VarChar(255)
  sourceRowNumber  Int          @map("source_row_number")
  payload          Json
  createdAt        DateTime     @default(now()) @map("created_at")
  organization     Organization @relation(fields: [orgId], references: [id], onDelete: Restrict)
  sourceDocument   Document     @relation(fields: [sourceDocumentId], references: [id], onDelete: Restrict)
  importBatch      ImportBatch  @relation(fields: [importBatchId], references: [id], onDelete: Cascade)

  @@unique([importBatchId, sourceSheetIndex, sourceRowNumber], map: "supplier_catalog_rows_batch_sheet_row_uq")
  @@index([orgId, importBatchId])
  @@map("supplier_catalog_rows")
}

model AuditLog {
  id              String       @id @default(cuid()) @db.VarChar(32)
  orgId           String       @map("org_id") @db.VarChar(64)
  actorEmployeeId String?      @map("actor_employee_id") @db.VarChar(32)
  action          String       @db.VarChar(128)
  targetType      String       @map("target_type") @db.VarChar(128)
  targetId        String?      @map("target_id") @db.VarChar(128)
  result          String       @default("succeeded") @db.VarChar(64)
  metadata        Json?
  requestId       String?      @map("request_id") @db.VarChar(128)
  clientIp        String?      @map("client_ip") @db.VarChar(128)
  clientSource    String?      @map("client_source") @db.VarChar(32)
  launcherVersion String?      @map("launcher_version") @db.VarChar(64)
  createdAt       DateTime     @default(now()) @map("created_at")
  organization    Organization @relation(fields: [orgId], references: [id], onDelete: Restrict)
  actor           Employee?    @relation("AuditActor", fields: [actorEmployeeId], references: [id], onDelete: SetNull)

  @@index([orgId, createdAt])
  @@index([actorEmployeeId])
  @@index([targetType, targetId])
  @@map("audit_logs")
}

model SkillEntry {
  id                  String           @id @default(cuid()) @db.VarChar(32)
  orgId               String           @map("org_id") @db.VarChar(64)
  name                String           @db.VarChar(255)
  description         String           @db.Text
  version             String           @db.VarChar(64)
  category            String           @db.VarChar(128)
  inputRequirements   Json             @map("input_requirements")
  installInstructions String           @map("install_instructions") @db.Text
  examplePrompts      Json             @map("example_prompts")
  status              SkillEntryStatus @default(approved)
  createdAt           DateTime         @default(now()) @map("created_at")
  updatedAt           DateTime         @updatedAt @map("updated_at")
  organization        Organization     @relation(fields: [orgId], references: [id], onDelete: Restrict)

  @@unique([orgId, name, version])
  @@index([orgId, status])
  @@map("skill_entries")
}

model LoginIdentity {
  id                   String                 @id @default(cuid()) @db.VarChar(32)
  orgId                String                 @map("org_id") @db.VarChar(64)
  employeeId           String                 @map("employee_id") @db.VarChar(32)
  provider             LoginIdentityProvider  @default(local_password)
  /// Login email is application-normalized and stored with the exact utf8mb4_bin migration collation.
  normalizedEmail      String                 @unique @map("normalized_email") @db.VarChar(320)
  passwordHash         String?                @map("password_hash") @db.Text
  disabled             Boolean                @default(false)
  failedAttemptCount   Int                    @default(0) @map("failed_attempt_count")
  cooldownLevel        Int                    @default(0) @map("cooldown_level")
  cooldownUntil        DateTime?              @map("cooldown_until")
  createdAt            DateTime               @default(now()) @map("created_at")
  updatedAt            DateTime               @updatedAt @map("updated_at")
  organization         Organization           @relation(fields: [orgId], references: [id], onDelete: Restrict)
  employee             Employee               @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  setupGrants          PasswordSetupGrant[]
  setupSessions        PasswordSetupSession[]
  authSessions         AuthSession[]
  accessTokens         OAuthAccessToken[]
  deviceAuthorizations DeviceAuthorization[]
  securityEvents       AuthSecurityEvent[]

  @@index([orgId, employeeId])
  @@index([employeeId, provider, disabled])
  @@map("login_identities")
}

model PasswordSetupGrant {
  id            String                 @id @default(cuid()) @db.VarChar(32)
  identityId    String                 @map("identity_id") @db.VarChar(32)
  purpose       PasswordSetupPurpose
  tokenHash     String                 @unique @map("token_hash") @db.Char(64)
  expiresAt     DateTime               @map("expires_at")
  usedAt        DateTime?              @map("used_at")
  revokedAt     DateTime?              @map("revoked_at")
  createdAt     DateTime               @default(now()) @map("created_at")
  identity      LoginIdentity          @relation(fields: [identityId], references: [id], onDelete: Cascade)
  setupSessions PasswordSetupSession[]

  @@index([identityId, purpose, expiresAt])
  @@map("password_setup_grants")
}

model PasswordSetupSession {
  id          String             @id @default(cuid()) @db.VarChar(32)
  identityId  String             @map("identity_id") @db.VarChar(32)
  grantId     String             @map("grant_id") @db.VarChar(32)
  sessionHash String             @unique @map("session_hash") @db.Char(64)
  expiresAt   DateTime           @map("expires_at")
  consumedAt  DateTime?          @map("consumed_at")
  revokedAt   DateTime?          @map("revoked_at")
  createdAt   DateTime           @default(now()) @map("created_at")
  identity    LoginIdentity      @relation(fields: [identityId], references: [id], onDelete: Cascade)
  grant       PasswordSetupGrant @relation(fields: [grantId], references: [id], onDelete: Cascade)

  @@index([identityId, expiresAt])
  @@index([grantId])
  @@map("password_setup_sessions")
}

model DeviceAuthorization {
  id               String                    @id @default(cuid()) @db.VarChar(32)
  clientId         String                    @map("client_id") @db.VarChar(128)
  deviceCodeHash   String                    @unique @map("device_code_hash") @db.Char(64)
  userCodeHash     String                    @unique @map("user_code_hash") @db.Char(64)
  status           DeviceAuthorizationStatus @default(pending)
  instanceName     String                    @map("instance_name") @db.VarChar(128)
  instanceHostname String                    @map("instance_hostname") @db.VarChar(255)
  identityId       String?                   @map("identity_id") @db.VarChar(32)
  employeeId       String?                   @map("employee_id") @db.VarChar(32)
  orgId            String?                   @map("org_id") @db.VarChar(64)
  expiresAt        DateTime                  @map("expires_at")
  completedAt      DateTime?                 @map("completed_at")
  redeemedAt       DateTime?                 @map("redeemed_at")
  revokedAt        DateTime?                 @map("revoked_at")
  createdAt        DateTime                  @default(now()) @map("created_at")
  updatedAt        DateTime                  @updatedAt @map("updated_at")
  identity         LoginIdentity?            @relation(fields: [identityId], references: [id], onDelete: SetNull)
  employee         Employee?                 @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  organization     Organization?             @relation(fields: [orgId], references: [id], onDelete: SetNull)

  @@index([clientId, instanceName, instanceHostname, status], map: "device_authorizations_instance_status_idx")
  @@index([identityId, status])
  @@index([expiresAt])
  @@map("device_authorizations")
}

model AuthSession {
  id                 String              @id @default(cuid()) @db.VarChar(32)
  identityId         String              @map("identity_id") @db.VarChar(32)
  employeeId         String              @map("employee_id") @db.VarChar(32)
  orgId              String              @map("org_id") @db.VarChar(64)
  status             AuthSessionStatus   @default(active)
  absoluteExpiresAt  DateTime            @map("absolute_expires_at")
  revokedAt          DateTime?           @map("revoked_at")
  revocationReason   String?             @map("revocation_reason") @db.VarChar(128)
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")
  identity           LoginIdentity       @relation(fields: [identityId], references: [id], onDelete: Restrict)
  employee           Employee            @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  organization       Organization        @relation(fields: [orgId], references: [id], onDelete: Restrict)
  durableCredentials DurableCredential[]
  accessTokens       OAuthAccessToken[]
  securityEvents     AuthSecurityEvent[]

  @@index([identityId, status])
  @@index([orgId, employeeId, status])
  @@index([absoluteExpiresAt])
  @@map("auth_sessions")
}

model DurableCredential {
  id             String                  @id @default(cuid()) @db.VarChar(32)
  sessionId      String                  @map("session_id") @db.VarChar(32)
  credentialHash String                  @unique @map("credential_hash") @db.Char(64)
  generation     Int
  status         DurableCredentialStatus @default(active)
  consumedAt     DateTime?               @map("consumed_at")
  revokedAt      DateTime?               @map("revoked_at")
  createdAt      DateTime                @default(now()) @map("created_at")
  session        AuthSession             @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, generation])
  @@index([sessionId, status])
  @@map("durable_credentials")
}

model OAuthAccessToken {
  id           String        @id @default(cuid()) @db.VarChar(32)
  sessionId    String        @map("session_id") @db.VarChar(32)
  identityId   String        @map("identity_id") @db.VarChar(32)
  employeeId   String        @map("employee_id") @db.VarChar(32)
  orgId        String        @map("org_id") @db.VarChar(64)
  tokenHash    String        @unique @map("token_hash") @db.Char(64)
  expiresAt    DateTime      @map("expires_at")
  revokedAt    DateTime?     @map("revoked_at")
  lastUsedAt   DateTime?     @map("last_used_at")
  createdAt    DateTime      @default(now()) @map("created_at")
  session      AuthSession   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  identity     LoginIdentity @relation(fields: [identityId], references: [id], onDelete: Restrict)
  employee     Employee      @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  organization Organization  @relation(fields: [orgId], references: [id], onDelete: Restrict)

  @@index([sessionId, expiresAt])
  @@index([identityId, expiresAt])
  @@index([orgId, employeeId])
  @@map("oauth_access_tokens")
}

model AuthSecurityEvent {
  id              String              @id @default(cuid()) @db.VarChar(32)
  eventType       String              @map("event_type") @db.VarChar(128)
  outcome         AuthSecurityOutcome
  reason          String?             @db.VarChar(255)
  requestId       String?             @map("request_id") @db.VarChar(128)
  sourceIp        String?             @map("source_ip") @db.VarChar(128)
  launcherVersion String?             @map("launcher_version") @db.VarChar(64)
  orgId           String?             @map("org_id") @db.VarChar(64)
  identityId      String?             @map("identity_id") @db.VarChar(32)
  employeeId      String?             @map("employee_id") @db.VarChar(32)
  sessionId       String?             @map("session_id") @db.VarChar(32)
  createdAt       DateTime            @default(now()) @map("created_at")
  organization    Organization?       @relation(fields: [orgId], references: [id], onDelete: SetNull)
  identity        LoginIdentity?      @relation(fields: [identityId], references: [id], onDelete: SetNull)
  employee        Employee?           @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  session         AuthSession?        @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([orgId, createdAt])
  @@index([identityId, createdAt])
  @@index([sessionId, createdAt])
  @@map("auth_security_events")
}
