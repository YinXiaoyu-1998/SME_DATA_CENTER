  storeNameHash              String                      @map("store_name_hash") @db.Char(64)
  purchaseDate               DateTime                    @map("purchase_date") @db.Date
  dataRevision               Int                         @default(0) @map("data_revision") @db.UnsignedInt
  requestedGeneration        Int                         @default(0) @map("requested_generation") @db.UnsignedInt
  publishedGeneration        Int?                        @map("published_generation") @db.UnsignedInt
  publishedDataRevision      Int?                        @map("published_data_revision") @db.UnsignedInt
  publishedSourceFingerprint String?                     @map("published_source_fingerprint") @db.Char(64)
  currentObjectKey           String?                     @map("current_object_key") @db.VarChar(1024)
  checksumSha256             String?                     @map("checksum_sha256") @db.Char(64)
  byteSize                   BigInt?                     @map("byte_size") @db.UnsignedBigInt
  rowCount                   Int?                        @map("row_count") @db.UnsignedInt
  certificateCount           Int?                        @map("certificate_count") @db.UnsignedInt
  confidentialityLevel       Int                         @default(0) @map("confidentiality_level") @db.UnsignedTinyInt
  templateVersion            String?                     @map("template_version") @db.VarChar(128)
  generatedAt                DateTime?                   @map("generated_at")
  errorCode                  String?                     @map("error_code") @db.VarChar(128)
  createdAt                  DateTime                    @default(now()) @map("created_at")
  updatedAt                  DateTime                    @updatedAt @map("updated_at")
  organization               Organization                @relation(fields: [orgId], references: [id], onDelete: Restrict)
  items                      LedgerArtifactRequestItem[]
  sources                    LedgerPdfSource[]

  @@unique([orgId, id])
  @@unique([orgId, storeNameHash, purchaseDate], map: "ledger_pdf_partition_key_uq")
  @@index([orgId, purchaseDate])
  @@map("ledger_pdf_partitions")
}

model LedgerArtifactRequest {
  id                  String                      @id @default(cuid()) @db.VarChar(32)
  orgId               String                      @map("org_id") @db.VarChar(64)
  kind                LedgerArtifactRequestKind
  actorKind           LedgerActorKind             @map("actor_kind")
  actorUserAccountId     String?                     @map("actor_employee_id") @db.VarChar(32)
  actorLabel          String?                     @map("actor_label") @db.VarChar(255)
  reconciliationRunId String?                     @map("reconciliation_run_id") @db.VarChar(32)
  /// Opaque case-sensitive key; binary collation is applied by the archive migration.
  idempotencyKey      String                      @map("idempotency_key") @db.VarChar(255)
  requestFingerprint  String                      @map("request_fingerprint") @db.Char(64)
  scope               Json
  status              LedgerArtifactRequestStatus @default(queued)
  zipObjectKey        String?                     @map("zip_object_key") @db.VarChar(1024)
  zipExpiresAt        DateTime?                   @map("zip_expires_at")
  retryOfRequestId    String?                     @map("retry_of_request_id") @db.VarChar(32)
  errorCode           String?                     @map("error_code") @db.VarChar(128)
  createdAt           DateTime                    @default(now()) @map("created_at")
  updatedAt           DateTime                    @updatedAt @map("updated_at")
  organization        Organization                @relation(fields: [orgId], references: [id], onDelete: Restrict)
  actor               UserAccount?                   @relation(fields: [orgId, actorUserAccountId], references: [orgId, id], onDelete: Restrict)
  reconciliationRun   LedgerPdfReconciliationRun? @relation(fields: [orgId, reconciliationRunId], references: [orgId, id], onDelete: Restrict)
  retryOfRequest      LedgerArtifactRequest?      @relation("LedgerRequestRetry", fields: [orgId, retryOfRequestId], references: [orgId, id], onDelete: Restrict)
  retries             LedgerArtifactRequest[]     @relation("LedgerRequestRetry")
  items               LedgerArtifactRequestItem[]
  processingRun       ProcessingRun?

  @@unique([orgId, id])
  @@unique([orgId, idempotencyKey], map: "ledger_artifact_request_idempotency_uq")
  @@index([orgId, status, createdAt])
  @@index([kind, zipExpiresAt])
  @@map("ledger_artifact_requests")
}

model LedgerArtifactRequestItem {
  id            String                   @id @default(cuid()) @db.VarChar(32)
  orgId         String                   @map("org_id") @db.VarChar(64)
  requestId     String                   @map("request_id") @db.VarChar(32)
  partitionId   String                   @map("partition_id") @db.VarChar(32)
  generation    Int                      @db.UnsignedInt
  dataRevision  Int                      @map("data_revision") @db.UnsignedInt
  status        LedgerArtifactItemStatus @default(queued)
  errorCode     String?                  @map("error_code") @db.VarChar(128)
  createdAt     DateTime                 @default(now()) @map("created_at")
  updatedAt     DateTime                 @updatedAt @map("updated_at")
  request       LedgerArtifactRequest    @relation(fields: [orgId, requestId], references: [orgId, id], onDelete: Restrict)
  partition     LedgerPdfPartition       @relation(fields: [orgId, partitionId], references: [orgId, id], onDelete: Restrict)
  processingRun ProcessingRun?
  reconciliationTargets LedgerPdfReconciliationTarget[]

  @@unique([orgId, id])
  @@unique([requestId, partitionId])
  @@index([orgId, partitionId, generation])
  @@index([orgId, requestId, status])
  @@map("ledger_artifact_request_items")
}

model LedgerPdfSource {
  id                   String              @id @default(cuid()) @db.VarChar(32)
  orgId                String              @map("org_id") @db.VarChar(64)
  partitionId          String              @map("partition_id") @db.VarChar(32)
  sourceDocumentId     String              @map("source_document_id") @db.VarChar(32)
