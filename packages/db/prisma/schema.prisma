model LedgerPdfReconciliationRun {
  id                   String                      @id @default(cuid()) @db.VarChar(32)
  orgId                String                      @map("org_id") @db.VarChar(64)
  scheduleDate         DateTime                    @map("schedule_date") @db.Date
  status               LedgerArtifactRequestStatus @default(queued)
  phase                String                      @default("facts") @db.VarChar(32)
  cursor               Json?
  scannedCount         Int                         @default(0) @map("scanned_count") @db.UnsignedInt
  healthyCount         Int                         @default(0) @map("healthy_count") @db.UnsignedInt
  abnormalCount        Int                         @default(0) @map("abnormal_count") @db.UnsignedInt
  submittedCount       Int                         @default(0) @map("submitted_count") @db.UnsignedInt
  inflightSkippedCount Int                         @default(0) @map("inflight_skipped_count") @db.UnsignedInt
  failedCount          Int                         @default(0) @map("failed_count") @db.UnsignedInt
  startedAt            DateTime?                   @map("started_at")
  finishedAt           DateTime?                   @map("finished_at")
  errorCode            String?                     @map("error_code") @db.VarChar(128)
  createdAt            DateTime                    @default(now()) @map("created_at")
  updatedAt            DateTime                    @updatedAt @map("updated_at")
  organization         Organization                @relation(fields: [orgId], references: [id], onDelete: Restrict)
  processingRun        ProcessingRun?
  requests             LedgerArtifactRequest[]
  targets              LedgerPdfReconciliationTarget[]

  @@unique([orgId, id])
  @@unique([orgId, scheduleDate], map: "ledger_reconciliation_schedule_uq")
  @@index([orgId, status])
  @@map("ledger_pdf_reconciliation_runs")
}

/// Exact repair targets, including reused requests owned by another actor/run.
model LedgerPdfReconciliationTarget {
  id                  String @id @default(cuid()) @db.VarChar(32)
  orgId               String @map("org_id") @db.VarChar(64)
  reconciliationRunId String @map("reconciliation_run_id") @db.VarChar(32)
  requestItemId       String @map("request_item_id") @db.VarChar(32)
  createdAt           DateTime @default(now()) @map("created_at")
  reconciliationRun   LedgerPdfReconciliationRun @relation(fields: [orgId, reconciliationRunId], references: [orgId, id], onDelete: Restrict, map: "ledger_reconciliation_target_run_fk")
  requestItem         LedgerArtifactRequestItem @relation(fields: [orgId, requestItemId], references: [orgId, id], onDelete: Restrict, map: "ledger_reconciliation_target_item_fk")

  @@unique([reconciliationRunId, requestItemId], map: "ledger_reconciliation_target_uq")
  @@index([orgId, requestItemId])
  @@map("ledger_pdf_reconciliation_targets")
}

