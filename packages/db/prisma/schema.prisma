  assignmentEpoch Int @map("assignment_epoch") @db.UnsignedInt
  workflowPackageVersion String @map("workflow_package_version") @db.VarChar(64)
  startDate DateTime @map("start_date") @db.Date
  endDate DateTime @map("end_date") @db.Date
  mode String @db.VarChar(32)
  snapshot Json
  restrictivePolicy Json? @map("restrictive_policy")
  phase String @default("preparing") @db.VarChar(32)
