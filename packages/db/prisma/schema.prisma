// Kept after run detail expiry and workflow revocation. Never cascade-delete dedup history.
model WorkflowAction {
  deduplicationKeys WorkflowActionDeduplication[]
  orgId String @map("org_id") @db.VarChar(64)
  workflowId String @map("workflow_id") @db.VarChar(64)
  actionId String @map("action_id") @db.VarChar(64)
  runId String @map("run_id") @db.VarChar(64)
  idempotencyKey String @map("idempotency_key") @db.Char(64)
  identity Json
  artifactHash String? @map("artifact_hash") @db.Char(64)
  correlationMarker String? @map("correlation_marker") @db.VarChar(64)
  state WorkflowActionState @default(intent)
  receipt Json?
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(3)
  confirmedAt DateTime? @map("confirmed_at") @db.DateTime(3)
  workflow EnterpriseWorkflow @relation(fields: [orgId, workflowId], references: [orgId, id], onDelete: Restrict, onUpdate: Restrict)
  @@id([orgId, workflowId, actionId])
  @@unique([orgId, workflowId, idempotencyKey], map: "uq_workflow_action_dedup")
  @@index([orgId, workflowId, state])
  @@index([orgId, workflowId, runId, actionId], map: "ix_workflow_actions_run_inventory")
  @@map("workflow_actions")
}

