{
  "name": "smedc",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "test": "vitest run",
    "check:naming": "tsx scripts/check-smedc-naming.ts",
    "audit:production": "tsx scripts/check-vulnerability-policy.ts npm-audit",
    "audit:report": "tsx scripts/check-vulnerability-policy.ts report",
    "test:integration": "tsx scripts/test-integration.ts",
    "test:device-headless": "tsx scripts/test-device-login.ts",
    "test:storage:oss": "RUN_OSS_INTEGRATION=1 vitest run packages/storage/src/aliyun-oss-storage.integration.test.ts",
    "test:mcp": "tsx scripts/test-mcp-local.ts",
    "test:phase3:golden": "tsx scripts/golden-retrieval-eval.ts",
    "test:phase3:fixture-golden": "tsx scripts/evidence-fixture-golden.ts",
    "test:phase3:perf": "tsx scripts/phase3-performance-gates.ts",
    "generate:xlsx-fixtures": "tsx scripts/generate-structured-xlsx-fixtures.ts",
    "generate:rejected-fixtures": "tsx scripts/generate-structured-rejected-upload-fixtures.ts",
    "benchmark:xlsx-parse": "tsx scripts/benchmark-xlsx-parse.ts",
    "build:calamine-reader": "cargo build --locked --release --manifest-path native/calamine-reader/Cargo.toml",
    "profile:partitions": "tsx scripts/profile-partition-source.ts",
    "test:manual:prepare": "tsx scripts/manual-test-harness.ts prepare",
    "test:manual:serve": "tsx scripts/manual-test-harness.ts serve",
    "test:manual:snapshot": "tsx scripts/manual-test-harness.ts snapshot",
    "test:manual:cleanup": "tsx scripts/manual-test-harness.ts cleanup",
    "staging:smoke": "tsx scripts/staging-smoke.ts",
    "test:official-manual": "tsx scripts/official-manual-acceptance.ts",
    "deploy:staging": "tsx scripts/deploy-staging.ts",
    "deploy:staging:rollback": "tsx scripts/deploy-staging.ts --rollback",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build:release": "tsup --config tsup.release.config.ts",
    "api:dev": "tsx apps/api/src/index.ts",
    "auth:operator": "tsx apps/api/src/auth/operator-cli.ts",
    "mcp:launcher": "npm --workspace smedc-mcp-launcher run --silent start --",
    "purge-data": "tsx scripts/purge-data.ts",
    "staging:cleanup-upload-domain": "tsx scripts/staging-upload-domain-cleanup.ts",
    "qdrant:init": "tsx scripts/readiness.ts init-qdrant",
    "evidence:reindex": "tsx scripts/reindex-evidence.ts",
    "readyz:local": "tsx scripts/readiness.ts check",
    "worker:dev": "tsx apps/worker/src/dev-loop.ts",
    "worker:once": "tsx apps/worker/src/index.ts",
    "db:compose:up": "docker compose up -d mysql",
    "runtime:compose:up": "docker compose up -d mysql qdrant",
    "db:compose:down": "docker compose down",
    "db:generate": "prisma generate --config packages/db/prisma.config.ts",
    "db:migrate": "prisma migrate dev --config packages/db/prisma.config.ts",
    "db:migrate:deploy": "prisma migrate deploy --config packages/db/prisma.config.ts",
    "db:seed": "prisma db seed --config packages/db/prisma.config.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/node": "^25.0.3",
    "@types/sax": "^1.2.7",
    "eslint": "^9.39.2",
    "globals": "^16.5.0",
    "prettier": "^3.7.4",
    "prisma": "7.9.1",
    "tsup": "8.5.1",
    "tsx": "^4.22.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.50.0",
    "vitest": "^4.0.16"
  },
  "dependencies": {
    "dotenv": "^17.4.2"
  },
  "overrides": {
    "hono": "4.13.5",
    "prisma": {
      "mysql2": "3.23.1"
    },
    "@prisma/config": {
      "deepmerge-ts": "8.0.2"
    },
    "@prisma/adapter-mariadb": {
      "mariadb": "3.5.3"
    }
  }
}
