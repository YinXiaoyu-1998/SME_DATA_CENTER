DATABASE_URL="mysql://smedc:smedc_local_password@localhost:3306/smedc"
STORAGE_DRIVER="local"
LOCAL_STORAGE_ROOT="./.data/storage"
# Required only when STORAGE_DRIVER="oss". Keep real credentials in ignored
# local env files or a deployment secret store, never in this example file.
AWS_REGION=""
AWS_ENDPOINT=""
AWS_S3_BUCKET=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_SESSION_TOKEN=""
AWS_S3_PREFIX="smedc"
AWS_S3_FORCE_PATH_STYLE="false"
AWS_S3_PRESIGN_EXPIRES_SECONDS="900"
CURSOR_SIGNING_SECRET="replace-with-local-development-cursor-secret"
SMEDC_PUBLIC_ORIGIN="https://api.smedatacenter.xyz"
MAX_UPLOAD_BYTES="52428800"
MAX_STRUCTURED_IMPORT_ROWS="100000"
MAX_XLSX_SHEETS="20"
MAX_STRUCTURED_CELL_CHARS="32767"
MAX_XLSX_UNCOMPRESSED_BYTES="209715200"
MAX_XLSX_ZIP_ENTRIES="10000"
MAX_XLSX_COMPRESSION_RATIO="100"
STRUCTURED_IMPORT_BATCH_INSERT_SIZE="500"
STRUCTURED_IMPORT_TRANSACTION_TIMEOUT_MS="120000"
MCP_MAX_CONCURRENT_REQUESTS="8"
MAX_DOCUMENT_CHARS="5000000"
MAX_CHUNKS_PER_DOCUMENT="5000"
WORKER_CONCURRENCY="2"
WORKER_LEASE_SECONDS="120"
WORKER_POLL_INTERVAL_MS="1000"
WORKER_MAX_ATTEMPTS="3"
WORKER_RETRY_BASE_MS="1000"
WORKER_RETRY_MAX_MS="60000"
PARTITION_IMPORT_MAX_SOURCE_BYTES="2147483648"
PARTITION_IMPORT_MAX_ROWS="5000000"
PARTITION_IMPORT_MAX_PARTITIONS="10000"
PARTITION_IMPORT_MAX_CANONICAL_BYTES="8589934592"
PARTITION_IMPORT_WORK_DIR="/var/lib/smedc/partition-work"
PARTITION_IMPORT_MIN_FREE_BYTES="12884901888"
PARTITION_IMPORT_OBJECT_CONCURRENCY="6"
PARTITION_IMPORT_JOB_RETENTION_DAYS="30"
PARTITION_UPLOAD_PART_BYTES="16777216"
PARTITION_UPLOAD_SESSION_TTL_SECONDS="86400"
PARTITION_MANIFEST_MAX_PARTITIONS="10000"
PARTITION_MANIFEST_URL_TTL_SECONDS="900"

# Phase 3 retrieval / structured data foundation
QDRANT_URL="http://127.0.0.1:6333"
QDRANT_API_KEY=""
# V1 rollback: phase3.retrieval.v1 + smedc_evidence_local (Qdrant sparse hash TF).
# V2 requires Qdrant >= 1.19.1 and a separately initialized collection:
# phase3.retrieval.v2-bm25 + smedc_evidence_local_v2 (native multilingual BM25).
QDRANT_COLLECTION_EVIDENCE="smedc_evidence_local"
QDRANT_TIMEOUT_MS="5000"
QDRANT_HTTP_PORT="6333"
QDRANT_GRPC_PORT="6334"
RETRIEVAL_CONFIG_VERSION="phase3.retrieval.v1"

# Existing model-provider control surface for Phase 3 embedding/rerank.
# Use fake locally/CI unless you intentionally enable an external provider.
LLM_PROVIDER="fake"
LLM_MODEL="fake-rerank"
LLM_EMBEDDING_MODEL="fake-embedding"
LLM_EMBEDDING_DIMENSION=""
RERANK_PROVIDER=""
OPENAI_COMPATIBLE_API_KEY=""
OPENAI_COMPATIBLE_BASE_URL=""
DASHSCOPE_API_KEY=""
DASHSCOPE_API_BASE_URL="https://dashscope.aliyuncs.com/api/v1"
EXTERNAL_MODEL_EGRESS_ACKNOWLEDGED="false"

# PDF uploads are disabled until an independently verified compatible rollback
# bundle and an authenticated offline parser are recorded by deploy:staging.
SMEDC_PDF_UPLOAD_ENABLED=false
SMEDC_PDF_PROCESSING_ENABLED=false
SMEDC_PDF_SERVICE_URL=http://172.30.96.2:8080
SMEDC_PDF_SERVICE_TOKEN=
SMEDC_PDF_PARSER_IMAGE=
SMEDC_PDF_RUNTIME_STATE_PATH=
# Existing worker stays general; the dedicated PDF worker fixes concurrency to 1.
WORKER_JOB_SCOPE=general
