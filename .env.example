# local env files or a deployment secret store, never in this example file.
AWS_REGION=""
AWS_ENDPOINT=""
AWS_S3_BUCKET=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_SESSION_TOKEN=""
AWS_S3_PREFIX="enterprise-hub"
AWS_S3_FORCE_PATH_STYLE="false"
AWS_S3_PRESIGN_EXPIRES_SECONDS="900"
CURSOR_SIGNING_SECRET="replace-with-local-development-cursor-secret"
ENTERPRISE_HUB_PUBLIC_ORIGIN="https://api.smedatacenter.xyz"
MAX_UPLOAD_BYTES="52428800"
MAX_STRUCTURED_IMPORT_ROWS="100000"
MAX_XLSX_SHEETS="20"
MAX_STRUCTURED_CELL_CHARS="32767"
MAX_XLSX_UNCOMPRESSED_BYTES="209715200"
MAX_XLSX_ZIP_ENTRIES="10000"
MAX_XLSX_COMPRESSION_RATIO="100"
STRUCTURED_IMPORT_BATCH_INSERT_SIZE="500"
STRUCTURED_IMPORT_TRANSACTION_TIMEOUT_MS="120000"
MCP_MAX_CONCURRENT_REQUESTS="8"
MAX_DOCUMENT_CHARS="5000000"
MAX_CHUNKS_PER_DOCUMENT="5000"
EVIDENCE_CHUNK_MAX_CHARS="1600"
EVIDENCE_CHUNK_OVERLAP_CHARS="200"
EVIDENCE_SECTION_MAX_CHARS="6000"
EVIDENCE_SECTION_MAX_CHUNKS="6"
WORKER_CONCURRENCY="2"
WORKER_LEASE_SECONDS="120"
WORKER_POLL_INTERVAL_MS="1000"
WORKER_MAX_ATTEMPTS="3"
WORKER_RETRY_BASE_MS="1000"
WORKER_RETRY_MAX_MS="60000"

# Phase 3 retrieval / structured data foundation
QDRANT_URL="http://127.0.0.1:6333"
QDRANT_API_KEY=""
QDRANT_COLLECTION_EVIDENCE="enterprise_hub_evidence_local"
QDRANT_TIMEOUT_MS="5000"
QDRANT_HTTP_PORT="6333"
QDRANT_GRPC_PORT="6334"
RETRIEVAL_CONFIG_VERSION="phase3.retrieval.v2"

