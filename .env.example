DATABASE_URL="mysql://enterprise_hub:enterprise_hub_local_password@localhost:3306/enterprise_hub"
STORAGE_DRIVER="local"
LOCAL_STORAGE_ROOT="./.data/storage"
JWT_SECRET="replace-with-local-development-secret"
DEV_SEED_ADMIN_EMAIL="admin@example.com"

# Phase 3 retrieval / structured data foundation
QDRANT_URL="http://127.0.0.1:6333"
QDRANT_API_KEY=""
QDRANT_COLLECTION_EVIDENCE="enterprise_hub_evidence_local"
QDRANT_TIMEOUT_MS="5000"
QDRANT_HTTP_PORT="6333"
QDRANT_GRPC_PORT="6334"
RETRIEVAL_CONFIG_VERSION="phase3.retrieval.v1"

# Existing model-provider control surface for Phase 3 embedding/rerank.
# Use fake locally/CI unless you intentionally enable an external provider.
LLM_PROVIDER="fake"
LLM_MODEL="fake-rerank"
LLM_EMBEDDING_MODEL="fake-embedding"
OPENAI_COMPATIBLE_API_KEY=""
OPENAI_COMPATIBLE_BASE_URL=""
EXTERNAL_MODEL_EGRESS_ACKNOWLEDGED="false"

STRUCTURED_QUERY_DEFAULT_LIMIT="50"
STRUCTURED_QUERY_MAX_LIMIT="200"
STRUCTURED_QUERY_MAX_BOOLEAN_DEPTH="3"
STRUCTURED_QUERY_MAX_CONDITIONS="20"
STRUCTURED_QUERY_MAX_IN_VALUES="100"
STRUCTURED_QUERY_MAX_SORT_FIELDS="2"
STRUCTURED_QUERY_MAX_GROUP_BY_FIELDS="1"
STRUCTURED_QUERY_MAX_AGGREGATES="5"
STRUCTURED_QUERY_MAX_SELECTED_FIELDS="50"
STRUCTURED_QUERY_CURSOR_TTL_SECONDS="900"
